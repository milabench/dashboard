{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/html/*", "/socket.io/*", "/assets/*"]
  },
  "routes": [
    {
      "route": "/api/*",
      "allowedRoles": ["anonymous"],
      "backendId": "backend"
    },
    {
      "route": "/html/*",
      "allowedRoles": ["anonymous"],
      "backendId": "backend"
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
