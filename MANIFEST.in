global-exclude *.pyc
global-exclude __pycache__

recursive-include dashboard *.json
recursive-include dashboard *.py
recursive-include dashboard *.mako
recursive-include dashboard/static *
recursive-include dashboard/alembic *
include dashboard/alembic.ini

include LICENSE
include requirements.txt

exclude .readthedocs.yml
exclude tox.ini
exclude Makefile
exclude .pylintrc
exclude .pre-commit-config.yaml
exclude scripts/generate_cookie.sh

prune docs
prune tests
prune examples
prune dashboard/plugins
prune dashboard/ui
